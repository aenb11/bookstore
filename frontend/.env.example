# Copy to .env.local and fill in. See "Authentication (Clerk)" in README.md.
# Keys: Clerk Dashboard → (your app) → Configure → API keys.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Where the app's own sign-in / sign-up pages live.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register

# Where to go after sign-in / sign-up when there is no redirect_url to return to.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
